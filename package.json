{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-splash",
  "version": "0.1.0",
  "description": "Full-screen, theme-aware startup splash for the OpenCode TUI with configurable ASCII art",
  "type": "module",
  "license": "MIT",
  "author": "Doug Steigerwald",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "splash",
    "ascii-art",
    "tui"
  ],
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "examples/rainbow.txt"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.7",
    "@opentui/core": "^0.8.4",
    "@opentui/solid": "^0.8.4",
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@opencode/theme": "^2.2.7",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
